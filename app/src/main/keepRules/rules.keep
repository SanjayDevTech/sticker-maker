# App-specific R8 rules. AGP merges every file in src/main/keepRules/.
# Libraries (Compose, Navigation 3, DataStore, kotlinx.serialization) ship their
# own consumer rules; add rules here only when a release build proves it needs one.

# Keep file/line info so release stack traces symbolicate via mapping.txt.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# No logging in release: R8 deletes these calls (and their string building).
-assumenosideeffects class android.util.Log {
    public static int v(...);
    public static int d(...);
    public static int i(...);
}

# JNI: the C side looks methods up by class and method name (editor/WebpNative ↔ cpp/webp_jni.c).
-keepclasseswithmembernames,includedescriptorclasses class * {
    native <methods>;
}
